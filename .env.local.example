# ====================================================
# CivicConnect Supabase Configuration
# ====================================================

# Supabase Project URL (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (From Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (Only used on secure backend servers)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME=CivicConnect
NEXT_PUBLIC_APP_TAGLINE=Your City. Your Voice. Your Right.
NEXT_PUBLIC_APP_URL=http://localhost:3000
